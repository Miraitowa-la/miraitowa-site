<script>
  import mermaid from 'mermaid';
  async function renderDiagrams() {
    const blocks = [...document.querySelectorAll<HTMLElement>('.mermaid-source')];
    if (!blocks.length) return;
    mermaid.initialize({ startOnLoad: false, securityLevel: 'strict', theme: 'neutral' });
    for (const [index, block] of blocks.entries()) {
      try {
        const { svg } = await mermaid.render(`note-diagram-${index}`, block.textContent || '');
        const figure = document.createElement('figure'); figure.className = 'mermaid-diagram'; figure.setAttribute('aria-label', 'Mermaid 图表');
        figure.innerHTML = svg; block.closest('.mermaid-block')!.replaceWith(figure);
      } catch {
        block.closest('.mermaid-block')!.querySelector('[role="status"]')!.textContent = '图表未能渲染，可展开查看源码。';
        block.closest('details')!.open = true;
      }
    }
  }
  renderDiagrams();
</script>
