---
import Icon from '../components/Icon.astro';
interface Props {
  note: { slug: string; title: string; description: string; date: string; updated?: string; category: string; tags: string[]; url: string };
}
const { note } = Astro.props;
---
<article class="project-card note-card" data-slug={note.slug} data-search={`${note.title} ${note.description} ${note.tags.join(' ')}`} data-tags={JSON.stringify(note.tags)} data-category={note.category}>
  <div class="project-card-top"><span class="project-category"><time datetime={note.date}>{note.date}</time> · {note.category}{note.updated && note.updated !== note.date && <> · 更新 <time datetime={note.updated}>{note.updated}</time></>}</span><span class="project-mark" aria-hidden="true"><Icon name="arrowUpRight" /></span></div>
  <h3><a href={note.url}>{note.title}</a></h3>
  <p>{note.description}</p>
  <ul class="project-tags">{note.tags.map((tag) => <li>{tag}</li>)}</ul>
  <div class="project-links"><a href={note.url}>阅读笔记 <Icon name="arrowRight" /></a></div>
</article>
