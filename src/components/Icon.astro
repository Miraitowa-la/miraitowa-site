---
import { icons, type IconName } from '../lib/icons';
interface Props { name: IconName; class?: string }
const { name, class: className = '' } = Astro.props;
---
<span class={`ui-icon ${className}`} aria-hidden="true"><Fragment set:html={icons[name].replace('<svg', '<svg aria-hidden="true" focusable="false"')} /></span>
