---
import Icon from '../components/Icon.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { projects } from '../data/projects';
import { site } from '../config/site';
import ProjectCard from '../components/ProjectCard.astro';

const categories = [...new Set(projects.map((project) => project.category))];
---
<BaseLayout title="开源项目" description="嵌入式通信、物联网应用与 Web 工具：浏览 Miraitowa 的公开项目和源代码。">
  <section class="projects-intro surface">
    <p class="eyebrow">从想法到实现 / OPEN PROJECTS</p>
    <h1>开源项目</h1>
    <p>从底层通信到应用工具，记录我在实践中的探索。<br />在 GitHub 查看源代码、使用说明与最新进展。</p>
    <div class="actions"><a class="button" href={`${site.github}?tab=repositories`}>全部 GitHub 仓库 <Icon name="externalLink" /></a></div>
  </section>
  <div class="project-groups">
    {categories.map((category, index) => (
      <section class="project-group" id={`category-${index}`} aria-label={category}>
        <div class="section-heading"><h2 class="accent-heading">{category}</h2><span>{projects.filter((project) => project.category === category).length} 个项目</span></div>
        <div class="project-grid">
          {projects.filter((project) => project.category === category).map((project) => (
            <ProjectCard project={project} />
          ))}
        </div>
      </section>
    ))}
  </div>
</BaseLayout>
