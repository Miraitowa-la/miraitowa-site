---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getNotes } from '../../lib/notes.mjs';
import '../../styles/blog.css';
const { notes } = await getNotes();
const categories = [...new Set(notes.map((note) => note.category))];
---
<BaseLayout title="技术博客" description="通过文章与双向链接，探索技术知识之间的关联。">
  <section class="projects-intro surface"><p class="eyebrow">连接知识 / CONNECT THE DOTS</p><h1>技术博客</h1><p>从一篇笔记出发，发现相互连接的知识。</p><div class="actions"><a class="button primary" href="/blog/graph/">探索知识图谱 ↗</a></div></section>
  <form class="blog-filters surface" onsubmit="return false"><label>搜索文章<input id="note-search" type="search" placeholder="标题、摘要或标签" /></label><label>分类<select id="note-category"><option value="">全部分类</option>{categories.map((category) => <option>{category}</option>)}</select></label></form>
  <p id="note-count" class="note-meta" aria-live="polite">共 {notes.length} 篇文章</p>
  <div class="note-list">{notes.map((note) => <article class="surface note-card" data-search={`${note.title} ${note.description} ${note.tags.join(' ')}`} data-category={note.category}><p class="note-meta"><time datetime={note.date}>{note.date}</time> · {note.category}</p><h2><a href={note.url}>{note.title}</a></h2><p>{note.description}</p><div class="topics">{note.tags.map((tag) => <span>{tag}</span>)}</div><a class="note-open" href={note.url}>阅读笔记 →</a></article>)}</div>
  <p id="note-empty" hidden>没有匹配的文章，试试其他关键词。</p>
</BaseLayout>
<script>
  const search = document.querySelector<HTMLInputElement>('#note-search')!;
  const category = document.querySelector<HTMLSelectElement>('#note-category')!;
  const cards = [...document.querySelectorAll<HTMLElement>('.note-card')];
  function filter() {
    let count = 0;
    for (const card of cards) {
      card.hidden = !(card.dataset.search!.toLowerCase().includes(search.value.trim().toLowerCase()) && (!category.value || card.dataset.category === category.value));
      if (!card.hidden) count++;
    }
    document.querySelector('#note-count')!.textContent = `共 ${count} 篇文章`;
    (document.querySelector('#note-empty') as HTMLElement).hidden = count !== 0;
  }
  search.addEventListener('input', filter); category.addEventListener('change', filter);
</script>
