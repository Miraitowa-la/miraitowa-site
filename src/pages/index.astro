---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../config/site';

const sections = [
  { number: '01', title: '技术博客', description: '记录学习笔记与开发过程。', href: '/blog/' },
  { number: '02', title: '开源项目', description: '把想法变成可以使用的作品。', href: '/projects/' },
  { number: '03', title: '关于我', description: '了解我的技术方向与探索。', href: '/about/' },
];
---
<BaseLayout title="首页">
  <section class="hero">
    <p class="eyebrow">个人技术主页 / PERSONAL SPACE</p>
    <h1>你好，我是 <span>{site.name}。</span><br />在实践中探索技术。</h1>
    <p class="hero-description">{site.description}<br />关注嵌入式、硬件开发与开源。</p>
    <div class="actions">
      <a class="button primary" href="/blog/">进入博客 <span aria-hidden="true">→</span></a>
      <a class="button" href={site.github}>访问 GitHub ↗</a>
    </div>
    <div class="topics" aria-label="技术方向"><span>嵌入式</span><span>硬件开发</span><span>开源</span></div>
  </section>
  <section class="explore" aria-labelledby="explore-title">
    <div class="section-heading"><h2 id="explore-title">从这里开始</h2><span>学习 · 实践 · 分享</span></div>
    <div class="cards">
      {sections.map(({ number, title, description, href }) => (
        <a class="card" href={href}>
          <span class="card-number">{number} <span aria-hidden="true">↗</span></span>
          <h3>{title}</h3>
          <p>{description}</p>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
